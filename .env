# ContractIQ Application Configuration
# Environment: Development
# IMPORTANT: Never commit .env files with real credentials to version control

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=contractiq_dev
DATABASE_USER=contractiq_user
DATABASE_PASSWORD=your_secure_password_here
DATABASE_SSL_MODE=disable
DATABASE_CONNECTION_POOL_SIZE=20
DATABASE_COMMAND_TIMEOUT=30

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET_KEY=your_super_secret_key_min_32_chars_here
JWT_ISSUER=ContractIQ
JWT_AUDIENCE=ContractIQ.API
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
JWT_ENABLE_MFA=false

# ============================================
# API CONFIGURATION
# ============================================
API_HOST=http://localhost:5000
API_PORT=5000
API_ENABLE_CORS=true
API_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
API_ENABLE_SWAGGER=true
API_RATE_LIMIT_REQUESTS_PER_MINUTE=100
API_RATE_LIMIT_ENABLED=true

# ============================================
# FRONTEND CONFIGURATION
# ============================================
FRONTEND_URL=http://localhost:4200
FRONTEND_PORT=4200
FRONTEND_ENVIRONMENT=development

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=Information
LOG_FILE_PATH=./logs/contractiq-.log
LOG_CONSOLE_OUTPUT=true
LOG_FILE_OUTPUT=true
SERILOG_MINIMUM_LEVEL=Information

# ============================================
# DOCUMENT GENERATION
# ============================================
DOCUMENT_TEMP_PATH=./temp/documents
DOCUMENT_OUTPUT_PATH=./output/documents
PDF_ENABLE_COMPRESSION=false
DOCX_ENABLE_TRACKING_CHANGES=false

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your_email@gmail.com
EMAIL_SMTP_PASSWORD=your_app_password_here
EMAIL_FROM_ADDRESS=noreply@contractiq.redmps.com
EMAIL_FROM_NAME=ContractIQ

# ============================================
# EXTERNAL INTEGRATIONS
# ============================================
# S3 Configuration (Optional)
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_S3_BUCKET=contractiq-documents

# Azure Configuration (Optional)
AZURE_ENABLED=false
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret

# ============================================
# COMPLIANCE & SECURITY
# ============================================
ENABLE_ENCRYPTION=true
ENCRYPTION_KEY=your_encryption_key_here
DATA_RETENTION_DAYS=2555
AUDIT_LOGGING_ENABLED=true
ENABLE_RATE_LIMITING=true

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AI_RECOMMENDATIONS=false
FEATURE_DIGITAL_SIGNATURES=false
FEATURE_BATCH_IMPORT=true
FEATURE_ADVANCED_REPORTING=false
FEATURE_CUSTOM_WORKFLOWS=false

# ============================================
# DEBUG & DEVELOPMENT
# ============================================
DEBUG_MODE=true
DETAILED_ERRORS=true
ENABLE_PROFILING=false
SEED_INITIAL_DATA=true

# ============================================
# PERFORMANCE
# ============================================
CACHE_ENABLED=true
CACHE_DURATION_MINUTES=30
QUERY_TIMEOUT_SECONDS=30
MAX_BATCH_SIZE=1000
