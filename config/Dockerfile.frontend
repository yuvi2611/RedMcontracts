# Multi-stage build for ContractIQ Frontend
FROM node:18-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build:prod

# Production stage
FROM node:18-alpine

WORKDIR /app

# Install serve to run production build
RUN npm install -g serve

COPY --from=builder /app/dist/contractiq ./dist

# Create non-root user
RUN addgroup -g 1000 contractiq && \
    adduser -D -u 1000 -G contractiq contractiq && \
    chown -R contractiq:contractiq /app
USER contractiq

EXPOSE 4200
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:4200/ || exit 1

CMD ["serve", "-s", "dist", "-l", "4200"]
