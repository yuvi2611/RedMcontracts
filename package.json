{
  "name": "contractiq-redmps",
  "version": "1.0.0",
  "private": true,
  "description": "RedMPS ContractIQ - dev utilities for prototypes and local preview",
  "scripts": {
    "api": "node src/backend/server.js",
    "dev": "live-server src/frontend --port=5500 --open=/demo-index.html --watch=src/frontend",
    "demo": "http-server src/frontend -p 8000 -c-1 -o /demo-index.html",
    "prototype": "http-server . -p 8000 -c-1 -o /redmps-hr-platform.html",
    "test:routes": "node src/frontend/demo/tests/route-smoke.test.js"
  },
  "dependencies": {
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "live-server": "^1.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
