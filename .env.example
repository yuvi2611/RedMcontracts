# ContractIQ Application Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_HOST=your-db-host.example.com
DATABASE_PORT=5432
DATABASE_NAME=neondb
DATABASE_USER=neondb_owner
DATABASE_PASSWORD=REPLACE_WITH_REAL_PASSWORD
DATABASE_SSL_MODE=require
DATABASE_CONNECTION_POOL_SIZE=20
DATABASE_COMMAND_TIMEOUT=30

# pgAdmin local management UI
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@redmps.com
PGADMIN_DEFAULT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET_KEY=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET
JWT_ISSUER=ContractIQ
JWT_AUDIENCE=ContractIQ.API
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
JWT_ENABLE_MFA=false

# ============================================
# API CONFIGURATION
# ============================================
API_HOST=http://localhost:5000
API_PORT=5000
API_ENABLE_CORS=true
API_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
API_ENABLE_SWAGGER=true
API_RATE_LIMIT_REQUESTS_PER_MINUTE=100
API_RATE_LIMIT_ENABLED=true

# ============================================
# FRONTEND CONFIGURATION
# ============================================
FRONTEND_URL=http://localhost:4200
FRONTEND_PORT=4200
FRONTEND_ENVIRONMENT=development

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=Information
LOG_FILE_PATH=./logs/contractiq-.log
LOG_CONSOLE_OUTPUT=true
LOG_FILE_OUTPUT=true
SERILOG_MINIMUM_LEVEL=Information

# ============================================
# DOCUMENT GENERATION
# ============================================
DOCUMENT_TEMP_PATH=./temp/documents
DOCUMENT_OUTPUT_PATH=./output/documents
PDF_ENABLE_COMPRESSION=false
DOCX_ENABLE_TRACKING_CHANGES=false

# ============================================
# EMAIL CONFIGURATION (Resend)
# ============================================
EMAIL_ENABLED=true
EMAIL_PROVIDER=resend
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM_ADDRESS=no-reply@yourdomain.com
EMAIL_FROM_NAME=ContractIQ
EMAIL_REPLY_TO=support@yourdomain.com

EMAIL_SUBJECT_CONTRACT_CREATED=Your contract has been created
EMAIL_SUBJECT_CONTRACT_SENT=A contract has been sent to you for review
EMAIL_SUBJECT_CONTRACT_APPROVED=Contract approved
EMAIL_SUBJECT_CONTRACT_REJECTED=Contract requires changes
EMAIL_SUBJECT_CONTRACT_EXPIRING=Contract expiring soon
EMAIL_SUBJECT_CONTRACT_EXPIRED=Contract has expired
EMAIL_SUBJECT_APPROVAL_REQUESTED=Action required: Contract approval request
EMAIL_SUBJECT_APPROVAL_REMINDER=Reminder: Pending contract approval
EMAIL_SUBJECT_USER_INVITE=You have been invited to ContractIQ
EMAIL_SUBJECT_PASSWORD_RESET=Reset your ContractIQ password
EMAIL_SUBJECT_WELCOME=Welcome to ContractIQ

EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY_SECONDS=5

# ============================================
# EXTERNAL INTEGRATIONS (optional)
# ============================================
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_IF_USING_AWS
AWS_SECRET_ACCESS_KEY=REPLACE_IF_USING_AWS
AWS_S3_BUCKET=contractiq-documents

AZURE_ENABLED=false
AZURE_TENANT_ID=REPLACE_IF_USING_AZURE
AZURE_CLIENT_ID=REPLACE_IF_USING_AZURE
AZURE_CLIENT_SECRET=REPLACE_IF_USING_AZURE

# ============================================
# COMPLIANCE & SECURITY
# ============================================
ENABLE_ENCRYPTION=true
ENCRYPTION_KEY=REPLACE_WITH_STRONG_ENCRYPTION_KEY
DATA_RETENTION_DAYS=2555
AUDIT_LOGGING_ENABLED=true
ENABLE_RATE_LIMITING=true

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AI_RECOMMENDATIONS=false
FEATURE_DIGITAL_SIGNATURES=false
FEATURE_BATCH_IMPORT=true
FEATURE_ADVANCED_REPORTING=false
FEATURE_CUSTOM_WORKFLOWS=false

# ============================================
# DEBUG & DEVELOPMENT
# ============================================
DEBUG_MODE=false
DETAILED_ERRORS=false
ENABLE_PROFILING=false
SEED_INITIAL_DATA=true

# ============================================
# PERFORMANCE
# ============================================
CACHE_ENABLED=true
CACHE_DURATION_MINUTES=30
QUERY_TIMEOUT_SECONDS=30
MAX_BATCH_SIZE=1000
